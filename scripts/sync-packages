#!/usr/bin/env bash
set -euo pipefail
export LC_ALL=C

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
MODE="${1:---write}"
if [ "$MODE" != "--check" ] && [ "$MODE" != "--write" ]; then
  echo "Usage: scripts/sync-packages [--check|--write]" >&2
  exit 2
fi

cd "$ROOT"
# Build and validate every package plan before any generator writes.
pnpm exec tsx scripts/sync-consolidated-plugin.ts --preflight

HAD_ERROR=0
for script in sync-consolidated-plugin sync-bundled-skills sync-hook-policy; do
  pnpm exec tsx "scripts/$script.ts" "$MODE" || HAD_ERROR=1
done

if [ "$HAD_ERROR" -eq 0 ]; then
  echo "=== All generated packages are in sync ==="
else
  echo "=== Generated packages are out of sync (run scripts/sync-all) ===" >&2
fi
exit $HAD_ERROR
