---
interface DocLink {
  href: string;
  label: string;
}

interface Props {
  links: DocLink[];
}

const { links } = Astro.props;
---

<nav aria-label="Related documentation" class="my-[clamp(2.5rem,5vw,3.5rem)] border-t border-home-border pt-5">
  <p class="m-0 mb-3 font-mono text-xs font-medium tracking-[0.1em] uppercase text-home-text-muted">Related docs</p>
  <ul class="m-0 flex flex-wrap gap-x-5 gap-y-3 p-0 list-none">
    {links.map((link) => (
      <li>
        <a
          class="inline-block border-b border-home-border-strong pb-0.5 text-sm text-home-text-soft no-underline transition-colors hover:border-home-accent hover:text-home-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--home-focus)]"
          href={link.href}
        >
          {link.label}
        </a>
      </li>
    ))}
  </ul>
</nav>
