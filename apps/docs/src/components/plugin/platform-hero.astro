---
/**
 * Left-aligned hero for plugin overview pages, in the homepage hero language:
 * Alan Sans display title, ink primary CTA, outlined secondary CTA. The page
 * title above it already names the package, so there is no eyebrow. Renders
 * an InstallCommand chip when `installCommand` is set.
 */
import InstallCommand from '@/components/plugin/install-command.astro';

interface Props {
  /** Display title (Alan Sans, balanced, max 24ch). */
  title: string;
  /** Lead paragraph under the title. */
  lead: string;
  primaryCta: { href: string; label: string };
  secondaryCta?: { href: string; label: string };
  installCommand?: string;
}

const { title, lead, primaryCta, secondaryCta, installCommand } = Astro.props;
---

<header class="flex flex-col items-start text-left min-w-0 pt-[clamp(4rem,8vw,6rem)]">
  <h1 class="hero-title">{title}</h1>
  <p class="hero-lead">{lead}</p>
  <!-- mb-6 gives the install chip deliberate air: the plugin-root reset
       zeroes sibling margin-top, so spacing rides on margin-bottom. -->
  <div class="hero-ctas flex items-center flex-wrap gap-3 mb-6">
    <a
      class="inline-flex items-center justify-center min-h-[44px] py-2.5 px-5 bg-[var(--home-ink-button)] text-[var(--home-ink-button-text)] rounded-[8px] font-sans text-[0.9375rem] font-[580] no-underline transition-transform active:scale-[0.97] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--home-focus)]"
      href={primaryCta.href}
    >{primaryCta.label}</a>
    {
      secondaryCta && (
        <a
          class="inline-flex items-center justify-center min-h-[44px] py-2.5 px-5 text-home-text font-sans text-[0.9375rem] font-[580] no-underline rounded-[8px] shadow-[inset_0_0_0_1px_var(--home-border-strong)] transition-colors hover:bg-home-surface-raised focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--home-focus)]"
          href={secondaryCta.href}
        >
          {secondaryCta.label}
        </a>
      )
    }
  </div>
  {installCommand && <InstallCommand command={installCommand} location="plugin-hero" align="start" />}
</header>

<style>
  .hero-title {
    margin: 0;
    font-family: 'Alan Sans Variable', sans-serif;
    font-size: clamp(2.25rem, 5.5vw, 3.75rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.04em;
    color: var(--home-text);
    max-width: 24ch;
    text-wrap: balance;
  }

  .hero-lead {
    margin: 1.25rem 0 0;
    font-size: clamp(1rem, 1.2vw, 1.0625rem);
    line-height: 1.65;
    color: var(--home-text-soft);
    max-width: 52rem;
    text-wrap: pretty;
  }

  /* Lead→CTA air (authored as mt-9 / max-md:mt-4 on this row). Utility
     margin-top is stripped by the plugin-root markdown reset between block
     siblings; a scoped rule outranks that unlayered reset. */
  .hero-ctas {
    margin-top: 2.25rem;
  }

  @media (width < 40rem) {
    .hero-ctas {
      margin-top: 1rem;
    }
  }
</style>
