---
import { markAttrs, marks } from '@/data/marks.js';
import { platforms } from '@/data/platforms.js';

interface FooterLink {
  href: string;
  title: string;
  external?: boolean;
}

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;

const footerColumns: { head: string; links: FooterLink[] }[] = [
  {
    head: 'Documentation',
    links: [
      { href: '/core/when-to-use/', title: 'When to Use' },
      { href: '/core/how-it-works/', title: 'How It Works' },
      { href: '/core/pipeline/', title: 'Pipeline & Roles' },
    ],
  },
  {
    head: 'Platforms',
    links: [
      { href: '/opencode/', title: 'OpenCode' },
      { href: '/claude-code/', title: 'Claude Code' },
      { href: Astro.url.pathname === '/' ? '#platforms' : '/#platforms', title: 'All platforms' },
    ],
  },
  {
    head: 'Community',
    links: [
      { external: true, href: 'https://github.com/agustinusnathaniel/maestria', title: 'GitHub' },
      { href: '/about/', title: 'About' },
      { href: '/contact/', title: 'Contact' },
      { href: '/privacy/', title: 'Privacy' },
      { href: '/core/contributing/', title: 'Contributing' },
      { href: '/core/changelog/', title: 'Changelog' },
    ],
  },
];

const platformColumns: { head: string; links: FooterLink[] }[] = [
  {
    head: 'Platforms',
    links: platforms
      .filter(({ auxiliary }) => auxiliary !== true)
      .map((platform) => ({
        href: platform.href,
        title: platform.shortName ?? platform.name,
      })),
  },
];

const columns = compact ? platformColumns : footerColumns;
---

<footer class:list={['site-footer', compact && 'site-footer--compact']}>
  <div class="site-footer__main">
    <div class="site-footer__brand">
      <div class="site-footer__identity">
        <svg aria-hidden="true" {...markAttrs} set:html={marks.orchestrator} />
        <span>maestria</span>
      </div>
      <p>Structured AI engineering workflows for your coding agent.</p>
    </div>

    <nav
      class="site-footer__nav"
      aria-label={compact ? 'Platform overviews' : 'Footer navigation'}
    >
      {
        columns.map((column) => (
          <div class="site-footer__column">
            <p class="foot-head">{column.head}</p>
            <ul>
              {column.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    target={link.external ? '_blank' : undefined}
                    rel={link.external ? 'noopener noreferrer' : undefined}
                  >
                    {link.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </div>

  <div class="site-footer__legal">
    <span>MIT License © 2026 maestria</span>
    <span>Built with Astro &amp; Starlight</span>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(3.5rem, 7vw, 5rem);
    padding: clamp(2.25rem, 5vw, 3rem) 0 0.5rem;
    border-top: 1px solid var(--home-border);
    color: var(--home-text-muted);
  }

  .site-footer__main {
    display: grid;
    grid-template-columns: minmax(12rem, 0.55fr) minmax(0, 1.45fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .site-footer__brand {
    min-width: 0;
  }

  .site-footer__identity {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--home-text);
    font-family: var(--font-mono);
    font-size: 0.9375rem;
  }

  .site-footer__identity svg {
    width: 1.375rem;
    height: 1.375rem;
  }

  .site-footer__brand p {
    max-width: 30ch;
    margin: 0.8rem 0 0;
    font-size: 0.8125rem;
    line-height: 1.6;
  }

  .site-footer__nav {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
    min-width: 0;
  }

  .site-footer__column {
    min-width: 0;
  }

  .foot-head {
    margin: 0;
    color: var(--home-text-muted);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .site-footer__column ul {
    display: grid;
    gap: 0.2rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__column a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    color: var(--home-text-soft);
    font-size: 0.875rem;
    line-height: 1.4;
    text-decoration: none;
  }

  .site-footer__column a:hover {
    color: var(--home-accent);
  }

  .site-footer__column a:focus-visible {
    outline: 2px solid var(--home-focus);
    outline-offset: 2px;
  }

  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--home-border);
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .site-footer--compact .site-footer__main {
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  .site-footer--compact .site-footer__brand p {
    display: none;
  }

  .site-footer--compact .site-footer__nav {
    display: block;
  }

  .site-footer--compact .site-footer__column ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin-top: 0.4rem;
  }

  .site-footer--compact .site-footer__column a {
    min-height: 44px;
  }

  @media (width < 48rem) {
    .site-footer__main,
    .site-footer--compact .site-footer__main {
      grid-template-columns: 1fr;
    }

    .site-footer__nav {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (width < 30rem) {
    .site-footer__nav {
      grid-template-columns: 1fr;
    }
  }
</style>
