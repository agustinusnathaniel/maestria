---
/**
 * Documentation links in either the full hairline list or a compact inline set.
 * The caller owns the surrounding navigation or list container.
 */
interface LinkItem {
  title: string;
  description?: string;
  href: string;
  external?: boolean;
}

interface Props {
  class?: string;
  compact?: boolean;
  items: readonly LinkItem[];
}

const { class: className, compact = false, items } = Astro.props;
---

{
  items.map((item, index) => (
    <a
      class:list={[
        'docs-link-list__row',
        compact && 'docs-link-list__row--compact',
        className,
        !compact && index === items.length - 1 && 'docs-link-list__row--last',
      ]}
      href={item.href}
      target={item.external ? '_blank' : undefined}
      rel={item.external ? 'noopener noreferrer' : undefined}
      data-external={item.external ? 'true' : undefined}
    >
      <span class="docs-link-list__title">{item.title}</span>
      {item.description && <span class="docs-link-list__description">{item.description}</span>}
      <span class="docs-link-list__arrow" aria-hidden="true">
        {item.external ? '↗' : '→'}
      </span>
    </a>
  ))
}
