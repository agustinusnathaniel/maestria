---
/**
 * Hairline link rows in the docs-map language: title, optional description,
 * and an arrow affordance, separated by top rules with a bottom rule closing
 * the stack. Renders rows only; the caller supplies the container.
 */
interface LinkItem {
  title: string;
  description?: string;
  href: string;
  external?: boolean;
}

interface Props {
  items: LinkItem[];
}

const { items } = Astro.props;
---

{
  items.map((item, index) => (
    <a
      class:list={[
        'group grid grid-cols-[minmax(0,15rem)_minmax(0,1fr)_auto] items-baseline gap-4 py-3.5 px-0.5 border-t border-home-border no-underline min-w-0 max-md:grid-cols-[minmax(0,1fr)_auto] focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-[var(--home-focus)]',
        index === items.length - 1 && 'border-b',
      ]}
      href={item.href}
      target={item.external ? '_blank' : undefined}
      rel={item.external ? 'noopener noreferrer' : undefined}
    >
      <span class="text-[0.9375rem] font-[560] text-home-text transition-colors group-hover:text-home-accent">{item.title}</span>
      {item.description && <span class="text-sm leading-[1.5] text-home-text-muted max-md:col-span-full">{item.description}</span>}
      <span class="text-home-text-muted transition-colors group-hover:text-home-accent group-hover:translate-x-[3px] max-md:col-2 max-md:row-1 max-md:justify-self-end" aria-hidden="true">→</span>
    </a>
  ))
}
