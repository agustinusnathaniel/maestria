---
interface Props {
  class?: string;
  id?: string;
  title: string;
}

const { class: className, id, title } = Astro.props;
const titleId = id ? `${id}-title` : undefined;
---

<section
  class:list={['plugin-section', className]}
  aria-labelledby={titleId}
  id={id}
>
  <h2 class="plugin-section__title" id={titleId}>{title}</h2>
  <div class="plugin-section__body">
    <slot />
  </div>
</section>

<style>
  .plugin-section {
    min-width: 0;
    padding-block: var(--ledger-section-gap);
    border-top: 1px solid var(--home-border);
  }

  .plugin-section__title {
    max-width: 30ch;
    margin: 0;
    color: var(--home-text);
    font-family: 'Alan Sans Variable', sans-serif;
    font-size: clamp(1.75rem, 3.2vw, 2.5rem);
    font-weight: 540;
    letter-spacing: -0.025em;
    line-height: 1.1;
    text-wrap: balance;
  }

  .plugin-section__body {
    min-width: 0;
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
  }
</style>
