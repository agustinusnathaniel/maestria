---
/**
 * Section scaffold for plugin overview pages: a heading and its content.
 * Spacing between sections is owned by the page: pass `class="mb-[…]"`.
 */
interface Props {
  title: string;
  /** Optional id for in-page anchors; also wires aria-labelledby. */
  id?: string;
}

const { title, id } = Astro.props;
---

<section class:list={['home-section', Astro.props.class]} aria-labelledby={id ? `${id}-title` : undefined} id={id}>
  <h2 id={id ? `${id}-title` : undefined} class="plugin-title">{title}</h2>
  <slot />
</section>

<style>
  /* Sub-page headings run one step smaller than homepage section headings. */
  .plugin-title {
    margin-bottom: 2rem;
    font-size: clamp(1.75rem, 3.4vw, 2.5rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--home-text);
    text-wrap: balance;
  }
</style>
