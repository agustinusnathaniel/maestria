---
interface CommandEntry {
  command: string;
  detail?: string;
  label?: string;
}

interface Props {
  commands?: readonly string[];
  entries?: readonly CommandEntry[];
  label?: string;
  note?: string;
}

const { commands = [], entries, label = 'Command ledger', note } = Astro.props;
const rows = entries ?? commands.map((command) => ({ command }));
const isSequence = rows.length > 1;
---

<section class="command-ledger" aria-label={label} data-command-ledger>
  <div class="command-ledger__header">
    <p>{label}</p>
    <span>{isSequence ? 'Run in order' : 'Entry point'}</span>
  </div>
  <ol>
    {
      rows.map((entry, index) => (
        <li>
          <span class="command-ledger__index" aria-hidden="true">
            {String(index + 1).padStart(2, '0')}
          </span>
          <div class="command-ledger__entry">
            {entry.label && <span class="command-ledger__label">{entry.label}</span>}
            <code>{entry.command}</code>
            {entry.detail && <span class="command-ledger__detail">{entry.detail}</span>}
          </div>
          <button
            type="button"
            class="command-copy"
            data-command-copy
            data-command={entry.command}
            data-copy-label="Copy"
            aria-label={`Copy ${entry.command}`}
          >
            Copy
          </button>
          <span class="sr-only" data-command-status aria-live="polite"></span>
        </li>
      ))
    }
  </ol>
  {note && <p class="command-ledger__note">{note}</p>}
</section>

<script>
  const commandLedgers = document.querySelectorAll<HTMLElement>('[data-command-ledger]');

  for (const ledger of commandLedgers) {
    if (ledger.dataset.commandReady === 'true') {
      continue;
    }
    ledger.dataset.commandReady = 'true';

    for (const button of ledger.querySelectorAll<HTMLButtonElement>('[data-command-copy]')) {
      button.addEventListener('click', async () => {
        const command = button.dataset.command ?? '';
        const status = button.parentElement?.querySelector<HTMLElement>('[data-command-status]');
        const resetLabel = button.dataset.copyLabel ?? 'Copy';

        try {
          if (!navigator.clipboard?.writeText) {
            throw new Error('Clipboard API unavailable');
          }
          await navigator.clipboard.writeText(command);
          button.dataset.copied = 'true';
          button.textContent = 'Copied';
          if (status) {
            status.textContent = 'Copied';
          }
          window.setTimeout(() => {
            delete button.dataset.copied;
            button.textContent = resetLabel;
            if (status) {
              status.textContent = '';
            }
          }, 1600);
        } catch {
          if (status) {
            status.textContent = 'Copy unavailable';
          }
        }
      });
    }
  }
</script>
