---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

import SiteFooter from '@/components/plugin/site-footer.astro';
import HomeDocs from '@/components/home/home-docs.astro';
import HomeHero from '@/components/home/home-hero.astro';
import HomeMethod from '@/components/home/home-method.astro';
import HomePlatforms from '@/components/home/home-platforms.astro';
import HomeProof from '@/components/home/home-proof.astro';
import HomeSpecialists from '@/components/home/home-specialists.astro';
---

<StarlightPage
  frontmatter={{
    title: 'Maestria',
    description:
      'A portable harness for AI coding agents. Route complex work through specialists, structured handoffs, and independent review.',
    template: 'splash',
    editUrl: false,
    lastUpdated: false,
  }}
>
  <div class="marketing-root">
    <div class="marketing-inner">
      <HomeHero />
      <HomePlatforms />
      <HomeMethod />
      <HomeSpecialists />
    </div>
    <HomeProof />
    <div class="marketing-inner">
      <HomeDocs />
      <SiteFooter />
    </div>
  </div>
</StarlightPage>
