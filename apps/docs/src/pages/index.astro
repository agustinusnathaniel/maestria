---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

import InstallCommand from '@/components/plugin/install-command.astro';
import SiteFooter from '@/components/plugin/site-footer.astro';
import { agents } from '@/data/agents.js';
import { installTargets } from '@/data/install-targets.js';
import { markAttrs, marks } from '@/data/marks.js';
import { platforms } from '@/data/platforms.js';
import { lanes, routes } from '@/data/routes.js';

const INSTALL_CMD = 'npx maestria install';
const DESCRIPTION =
  'A portable harness for AI coding agents. Route complex work through specialists, structured handoffs, and independent review.';

const agentName = new Map(agents.map((agent) => [agent.id, agent.name]));

/** Columns on the score: the longest route sets the time axis for all. */
const SCORE_COLUMNS = Math.max(...routes.map((route) => route.steps.length));

const principles = [
  {
    body: 'Small edits run directly. Specialists join only when they add information or reduce risk.',
    mark: 'pipeline',
    title: 'The smallest safe route',
  },
  {
    body: 'The builder never approves its own work. A reviewer who did not write it checks every meaningful change.',
    mark: 'makerChecker',
    title: 'A second pair of eyes',
  },
  {
    body: "The same roles and rules on every host, built on each tool's own agents, skills, and plugins.",
    mark: 'platforms',
    title: 'One method, native tools',
  },
];
---

<StarlightPage
  frontmatter={{
    title: 'maestria',
    description: DESCRIPTION,
    template: 'splash',
    hero: { tagline: '' },
    editUrl: false,
    lastUpdated: false,
  }}
>
  <div class="home not-content">
    <!-- ================================ HERO ================================ -->
    <div class="home-inner">
      <section class="hero" aria-labelledby="home-title">
        <h1 id="home-title" class="hero-title">Give your coding agent a team.</h1>
        <p class="hero-lead">
          Specialists for recon, design, planning, building, and review, called in only when a
          task needs them. One method for OpenCode, Pi, Claude Code, Codex, Cursor, and more.
        </p>
        <div class="hero-actions">
          <a class="btn btn-ink" href="/cli/getting-started/">Get started</a>
          <a class="btn btn-quiet" href="/core/how-it-works/">How it works</a>
          <InstallCommand command={INSTALL_CMD} location="home-hero" align="start" />
        </div>
      </section>
    </div>

    <!-- =========================== PIPELINE SCORE =========================== -->
    <section class="stage" id="pipeline" aria-labelledby="stage-title">
      <div class="home-inner">
        <div class="stage-head">
          <div>
            <h2 id="stage-title" class="stage-title">Make every step intentional.</h2>
            <p class="stage-lead">
              Pick a task. The orchestrator sends it only through the specialists that add
              information or reduce risk.
            </p>
          </div>
          <div class="route-tabs" role="tablist" aria-label="Example tasks" data-tabs="route">
            {routes.map((route, index) => (
              <button
                class="route-tab"
                type="button"
                role="tab"
                id={`route-tab-${route.id}`}
                aria-controls={`route-${route.id}`}
                aria-selected={index === 0 ? 'true' : 'false'}
                tabindex={index === 0 ? 0 : -1}
              >
                {route.label}
              </button>
            ))}
          </div>
        </div>

        {routes.map((route, index) => {
          const stepByAgent = new Map(route.steps.map((step, i) => [step.agent, { ...step, index: i }]));
          const lastIndex = route.steps.length - 1;
          return (
            <div
              class="score"
              role="tabpanel"
              id={`route-${route.id}`}
              aria-labelledby={`route-tab-${route.id}`}
              hidden={index !== 0}
              style={`--columns: ${SCORE_COLUMNS}`}
            >
              <p class="score-task">
                <span class="score-task-label">Task</span>
                <span class="score-task-text">{route.task}</span>
              </p>

              <div class="score-grid" aria-hidden="true">
                {lanes.map((group) => (
                  <div class="lane-group">
                    <span class="lane-stage">{group.stage}</span>
                    {group.agents.map((id) => {
                      const step = stepByAgent.get(id);
                      return (
                        <div class:list={['lane', { 'lane-idle': step === undefined }]}>
                          <span class="lane-name">
                            <svg class="lane-mark" {...markAttrs} set:html={marks[id]} />
                            {agentName.get(id)}
                          </span>
                          {step && (
                            <span
                              class:list={['note', { 'note-final': step.index === lastIndex }]}
                              style={`grid-column: ${step.index + 2} / -1`}
                              data-step={step.index}
                            >
                              <span class="note-marker" />
                              <span class="note-text">{step.artifact}</span>
                            </span>
                          )}
                        </div>
                      );
                    })}
                  </div>
                ))}
                <div class="playhead">
                  <span class="playhead-line" />
                </div>
              </div>

              <ol class="sr-only">
                {route.steps.map((step) => (
                  <li>{agentName.get(step.agent)}: {step.artifact}</li>
                ))}
              </ol>

              <p class="score-rationale">{route.rationale}</p>
            </div>
          );
        })}
      </div>
    </section>

    <div class="home-inner">
      <!-- ============================== METHOD ============================== -->
      <section class="home-section method" aria-labelledby="method-title">
        <h2 id="method-title" class="statement">
          An agent that plans, builds, and grades its own work will approve its own mistakes.{' '}
          <span class="statement-quiet">
            maestria separates the maker from the checker, hands context forward in structured
            briefs, and keeps each route as short as the task allows.
          </span>
        </h2>
        <div class="principles">
          {principles.map((principle) => (
            <article class="principle">
              <svg class="principle-mark" {...markAttrs} set:html={marks[principle.mark]} />
              <h3>{principle.title}</h3>
              <p>{principle.body}</p>
            </article>
          ))}
        </div>
      </section>

      <!-- ============================ SPECIALISTS ============================ -->
      <section class="home-section" id="specialists" aria-labelledby="agents-title">
        <div class="section-head">
          <h2 id="agents-title">Meet the specialists.</h2>
          <p>
            Each role has one job, one handoff, and one rule it never breaks.{' '}
            <a href="/core/agents/">Read the full reference</a>
          </p>
        </div>
        <ul class="roster" role="list">
          {agents.map((agent) => (
            <li class="roster-cell">
              <svg class="roster-mark" {...markAttrs} set:html={marks[agent.id]} />
              <h3>{agent.name}</h3>
              <p class="roster-role">{agent.role}</p>
              <dl>
                <div>
                  <dt>Hands off</dt>
                  <dd>{agent.artifact}</dd>
                </div>
                <div>
                  <dt>Rule</dt>
                  <dd>{agent.constraint}</dd>
                </div>
              </dl>
            </li>
          ))}
        </ul>
      </section>

      <!-- ============================== INSTALL ============================== -->
      <section class="home-section install" id="adapters" aria-labelledby="install-title">
        <div class="install-layout">
          <div class="section-head install-head">
            <h2 id="install-title">Install where you already work.</h2>
            <p>
              Run <code>{INSTALL_CMD}</code> to detect your agents and pick from a list, or name a
              host directly.
            </p>
          </div>

          <div class="install-picker">
            <div class="host-tabs" role="tablist" aria-label="Hosts" data-tabs="host">
              {installTargets.map((target, index) => (
                <button
                  class="host-tab"
                  type="button"
                  role="tab"
                  id={`host-tab-${target.id}`}
                  aria-controls={`host-${target.id}`}
                  aria-selected={index === 0 ? 'true' : 'false'}
                  tabindex={index === 0 ? 0 : -1}
                >
                  {target.name}
                </button>
              ))}
            </div>
            {installTargets.map((target, index) => (
              <div
                class="host-panel"
                role="tabpanel"
                id={`host-${target.id}`}
                aria-labelledby={`host-tab-${target.id}`}
                hidden={index !== 0}
              >
                <InstallCommand command={`npx maestria install ${target.id}`} location="home-picker" align="start" caption={false} />
                <p class="host-via">Installs {target.via}.</p>
                <a class="text-link" href={target.href}>{target.name} setup guide</a>
              </div>
            ))}
          </div>
        </div>

        <ul class="packages" role="list">
          {platforms.map((platform) => (
            <li>
              <a class="package" href={platform.href}>
                <svg class="package-mark" {...markAttrs} set:html={marks[platform.mark]} />
                <span class="package-name">{platform.name}</span>
                <span class="package-blurb">{platform.blurb}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <SiteFooter />
    </div>
  </div>
</StarlightPage>

<style>
  /* ============================================
     HERO
     ============================================ */

  .hero {
    padding-top: clamp(3.5rem, 9vw, 7.5rem);
    margin-bottom: clamp(3.5rem, 7vw, 5.5rem);
  }

  .hero-title {
    font-size: clamp(3rem, 8.6vw, 7.25rem);
    font-weight: 620;
    line-height: 0.96;
    letter-spacing: -0.045em;
    color: var(--home-text);
    text-wrap: balance;
    max-width: 13em;
    margin: 0 0 clamp(2rem, 4vw, 3rem);
  }

  .hero-lead {
    max-width: 36rem;
    font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
    line-height: 1.55;
    color: var(--home-text-soft);
    text-wrap: pretty;
    margin: 0 0 1.75rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0.75rem;
  }

  /* The install chip joins the action row; its caption hangs below it. The
     component's default top margin is for stacked layouts. */
  .hero-actions :global(.install-cmd) {
    margin: 0 0 0 clamp(0.25rem, 2vw, 1.25rem);
  }

  .hero-actions :global(.install-chip) {
    min-height: 44px;
  }

  @media (max-width: 639px) {
    .hero-actions :global(.install-cmd) {
      margin: 0.75rem 0 0;
      flex-basis: 100%;
    }
  }

  /* ============================================
     BUTTONS & LINKS
     ============================================ */

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.625rem 1.25rem;
    border-radius: 8px;
    font-size: 0.9375rem;
    font-weight: 580;
    text-decoration: none;
    transition:
      background-color 160ms ease-out,
      transform 120ms ease-out;
  }

  .btn:active {
    transform: scale(0.97);
  }

  .btn-ink {
    background: var(--home-ink-button);
    color: var(--home-ink-button-text);
  }

  .btn-quiet {
    color: var(--home-text);
    box-shadow: inset 0 0 0 1px var(--home-border-strong);
  }

  @media (hover: hover) and (pointer: fine) {
    .btn-ink:hover {
      background: color-mix(in srgb, var(--home-ink-button) 86%, var(--home-bg));
    }

    .btn-quiet:hover {
      background: var(--home-surface-raised);
    }
  }

  .btn:focus-visible,
  .text-link:focus-visible,
  .package:focus-visible,
  .section-head a:focus-visible {
    outline: 2px solid var(--home-focus);
    outline-offset: 2px;
  }

  .text-link,
  .section-head a {
    color: var(--home-accent);
    font-weight: 560;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .text-link:hover,
  .section-head a:hover {
    text-decoration-thickness: 2px;
  }

  /* ============================================
     PIPELINE SCORE - the deep green stage band
     ============================================ */

  .stage {
    --label: 11rem;
    background: var(--home-band);
    color: var(--home-band-text);
    padding-block: clamp(3rem, 6vw, 4.5rem);
    margin-bottom: var(--home-section-gap);
  }

  .stage-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    margin-bottom: clamp(2rem, 4vw, 2.75rem);
  }

  .stage-title {
    font-size: clamp(1.75rem, 3.2vw, 2.5rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--home-band-text);
    text-wrap: balance;
    margin: 0 0 0.75rem;
  }

  .stage-lead {
    max-width: 34rem;
    margin: 0;
    color: var(--home-band-muted);
    line-height: 1.55;
    text-wrap: pretty;
  }

  /* Segmented control: one track, the selected route lifts onto a raised
     chip. */
  .route-tabs {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    padding: 0.25rem;
    border-radius: 10px;
    background: rgba(0, 0, 0, 0.22);
    box-shadow: inset 0 0 0 1px var(--home-band-line);
  }

  .route-tab {
    min-height: 40px;
    padding: 0.5rem 0.9rem;
    border: 0;
    border-radius: 7px;
    background: transparent;
    color: var(--home-band-muted);
    font: inherit;
    font-size: 0.875rem;
    font-weight: 560;
    cursor: pointer;
    transition:
      background-color 160ms ease-out,
      color 160ms ease-out;
  }

  .route-tab:hover {
    color: var(--home-band-text);
  }

  .route-tab[aria-selected='true'] {
    background: var(--home-band-raised);
    color: var(--home-band-text);
    box-shadow: inset 0 0 0 1px var(--home-band-line);
  }

  .route-tab:focus-visible {
    outline: 2px solid var(--home-brass);
    outline-offset: 2px;
  }

  .score[hidden] {
    display: none;
  }

  .score-task {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    margin: 0 0 1.25rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--home-band-line);
  }

  .score-task-label {
    font-size: 0.875rem;
    color: var(--home-band-muted);
    min-width: calc(var(--label) - 0.75rem);
  }

  .score-task-text {
    font-family: var(--font-mono);
    font-size: clamp(0.9375rem, 1.4vw, 1.0625rem);
    color: var(--home-band-text);
  }

  .score-grid {
    position: relative;
  }

  .lane-group + .lane-group {
    margin-top: 0.5rem;
  }

  .lane-stage {
    display: block;
    font-size: 0.75rem;
    color: var(--home-band-muted);
    opacity: 0.75;
    padding-block: 0.25rem 0.125rem;
  }

  /* One stave per specialist: a label column, then one column per step. The
     stave line runs behind the notes; a note's text sits on the band color
     so it interrupts the line like a mark on a score. */
  .lane {
    position: relative;
    display: grid;
    grid-template-columns: var(--label) repeat(var(--columns), minmax(0, 1fr));
    align-items: center;
    min-height: 2.5rem;
  }

  .lane::before {
    content: '';
    position: absolute;
    left: var(--label);
    right: 0;
    top: 50%;
    height: 1px;
    background: var(--home-band-line);
  }

  .lane-name {
    grid-column: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 0.9375rem;
    font-weight: 540;
    color: var(--home-band-text);
    transition: opacity 240ms ease-out;
  }

  .lane-mark {
    width: 18px;
    height: 18px;
    flex: none;
    color: var(--home-band-muted);
  }

  .lane-idle .lane-name {
    opacity: 0.42;
  }

  .note {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    justify-self: start;
    max-width: 100%;
    padding-right: 0.625rem;
    background: var(--home-band);
    white-space: nowrap;
  }

  .note-marker {
    width: 11px;
    height: 11px;
    flex: none;
    margin-left: -5px;
    border-radius: 3px;
    background: var(--home-band-text);
    transform: rotate(45deg);
    transition:
      background-color 200ms ease-out,
      box-shadow 200ms ease-out;
  }

  .note-text {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--home-band-text);
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .note-final .note-marker {
    background: var(--home-brass);
  }

  .playhead {
    position: absolute;
    inset-block: 0;
    left: var(--label);
    right: 0;
    overflow: hidden;
    pointer-events: none;
    opacity: 0;
  }

  .playhead-line {
    display: block;
    width: 100%;
    height: 100%;
    border-left: 2px solid var(--home-brass);
    transform: translateX(calc(var(--pos, 0) / var(--columns) * 100% - 1px));
  }

  .score-rationale {
    margin: 1.5rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--home-band-line);
    padding-left: var(--label);
    color: var(--home-band-muted);
    line-height: 1.55;
    text-wrap: pretty;
  }

  /* Playback. Without JS (or with reduced motion) every note is visible and
     the playhead stays hidden. JS arms the score, then reveals each note as
     the playhead reaches its column. */
  .score.is-armed .note {
    opacity: 0;
    transform: translateX(-6px);
  }

  .score.is-armed .note.is-on {
    opacity: 1;
    transform: none;
  }

  .score.is-armed .playhead {
    opacity: 1;
  }

  .score.is-done .playhead {
    opacity: 0;
  }

  .note.is-current .note-marker {
    background: var(--home-brass);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--home-brass) 28%, transparent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .score.is-armed .note {
      transition:
        opacity 240ms ease-out,
        transform 240ms ease-out;
    }

    .playhead {
      transition: opacity 300ms ease-out;
    }

    .playhead-line {
      transition: transform 420ms ease-in-out;
    }
  }

  /* Narrow screens drop the time axis: lane order already matches step
     order on every route, so each note sits right after its label and the
     dimmed lanes still show which specialists were skipped. */
  @media (max-width: 767px) {
    .stage {
      --label: 8.5rem;
    }

    .lane {
      grid-template-columns: var(--label) minmax(0, 1fr);
    }

    .note {
      grid-column: 2 / -1 !important;
    }

    .lane-name {
      font-size: 0.875rem;
    }

    .route-tabs {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      width: 100%;
    }

    .playhead {
      display: none;
    }

    .score-rationale {
      padding-left: 0;
    }
  }

  @media (max-width: 420px) {
    .stage {
      --label: 7.25rem;
    }

    .lane-mark {
      display: none;
    }
  }

  /* ============================================
     SECTIONS
     ============================================ */

  .home-section {
    margin-bottom: var(--home-section-gap);
  }

  .section-head {
    max-width: 40rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .section-head h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.035em;
    color: var(--home-text);
    text-wrap: balance;
    margin: 0 0 1rem;
  }

  .section-head p {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--home-text-soft);
    text-wrap: pretty;
  }

  /* Method: a two-tone statement, then three principles on hairlines. */
  .statement {
    max-width: 62rem;
    font-size: clamp(1.625rem, 3.2vw, 2.625rem);
    font-weight: 580;
    line-height: 1.16;
    letter-spacing: -0.028em;
    color: var(--home-text);
    text-wrap: pretty;
    margin: 0 0 clamp(3rem, 6vw, 4.5rem);
  }

  .statement-quiet {
    color: var(--home-text-muted);
  }

  .principles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem clamp(1.5rem, 4vw, 3rem);
  }

  .principle {
    padding-top: 1.5rem;
    border-top: 1px solid var(--home-border-strong);
  }

  .principle-mark {
    width: 24px;
    height: 24px;
    color: var(--home-accent);
    margin-bottom: 1.25rem;
  }

  .principle h3,
  .roster-cell h3 {
    font-size: 1.1875rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.012em;
    color: var(--home-text);
    margin: 0 0 0.5rem;
  }

  .principle p {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--home-text-soft);
    max-width: 34ch;
  }

  /* Specialists roster: a hairline grid, no floating cards. */
  .roster {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--home-border);
    border-left: 1px solid var(--home-border);
  }

  .roster-cell {
    display: flex;
    flex-direction: column;
    padding: clamp(1.25rem, 2.2vw, 1.75rem);
    border-right: 1px solid var(--home-border);
    border-bottom: 1px solid var(--home-border);
    min-width: 0;
  }

  .roster-mark {
    width: 22px;
    height: 22px;
    color: var(--home-text-muted);
    margin-bottom: 1.5rem;
  }

  .roster-role {
    margin: 0 0 1.5rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--home-text-soft);
    text-wrap: pretty;
  }

  .roster-cell dl {
    margin: auto 0 0;
    display: grid;
    gap: 0.625rem;
  }

  .roster-cell dt {
    font-size: 0.75rem;
    color: var(--home-text-muted);
    margin: 0;
  }

  .roster-cell dd {
    margin: 0.125rem 0 0;
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--home-text);
  }

  /* Install: copy + host picker, then the package row. */
  .install-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: 2rem clamp(2rem, 6vw, 5rem);
    align-items: start;
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }

  .install-head {
    margin-bottom: 0;
  }

  .install-head code {
