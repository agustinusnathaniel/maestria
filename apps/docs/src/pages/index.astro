<script>
  /** Roving-tabindex tablist (APG pattern) shared by the route and host pickers. */
  const setupTabs = (tablist: HTMLElement, onSelect?: (panel: HTMLElement) => void): void => {
    const tabs = [...tablist.querySelectorAll<HTMLElement>('[role="tab"]')];

    const select = (tab: HTMLElement): void => {
      for (const t of tabs) {
        const selected = t === tab;
        t.setAttribute('aria-selected', String(selected));
        t.tabIndex = selected ? 0 : -1;
        const panel = document.querySelector<HTMLElement>(`#${CSS.escape(t.getAttribute('aria-controls') ?? '')}`);
        if (panel) {
          panel.hidden = !selected;
          if (selected) {onSelect?.(panel);}
        }
      }
      if (window.umami !== undefined) {
        window.umami.track(`${tablist.dataset.tabs ?? 'tab'}_select`, { value: tab.textContent?.trim() });
      }
    };

    for (const tab of tabs) {
      tab.addEventListener('click', () => select(tab));
    }

    tablist.addEventListener('keydown', (event) => {
      const index = tabs.indexOf(event.target as HTMLElement);
      if (index === -1) {return;}
      const keys: Record<string, number> = {
        ArrowDown: index + 1,
        ArrowLeft: index - 1,
        ArrowRight: index + 1,
        ArrowUp: index - 1,
        End: tabs.length - 1,
        Home: 0,
      };
      if (!(event.key in keys)) {return;}
      event.preventDefault();
      const next = tabs[(keys[event.key] + tabs.length) % tabs.length];
      select(next);
      next.focus();
    });
  };

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let timers: ReturnType<typeof setTimeout>[] = [];

  /** Walk the playhead across a route's steps, revealing each note in turn. */
  const playScore = (score: HTMLElement): void => {
    for (const timer of timers) {clearTimeout(timer);}
    timers = [];
    if (reducedMotion.matches) {return;}

    const notes = [...score.querySelectorAll<HTMLElement>('.note')].toSorted(
      (a, b) => Number(a.dataset.step) - Number(b.dataset.step),
    );
    score.classList.remove('is-done');
    score.classList.add('is-armed');
    score.style.setProperty('--pos', '0');
    for (const note of notes) {note.classList.remove('is-on', 'is-current');}

    const STEP_MS = 560;
    for (const [index, note] of notes.entries()) {
      timers.push(
        setTimeout(() => {
          score.style.setProperty('--pos', String(index));
          notes[index - 1]?.classList.remove('is-current');
          note.classList.add('is-on', 'is-current');
        }, 200 + index * STEP_MS),
      );
    }
    timers.push(
      setTimeout(() => {
        notes.at(-1)?.classList.remove('is-current');
        score.classList.add('is-done');
      }, 200 + notes.length * STEP_MS + 200),
    );
  };

  const routeTabs = document.querySelector<HTMLElement>('[data-tabs="route"]');
  const hostTabs = document.querySelector<HTMLElement>('[data-tabs="host"]');
  if (routeTabs) {setupTabs(routeTabs, playScore);}
  if (hostTabs) {setupTabs(hostTabs);}

  // Play the first route once, when the stage scrolls into view.
  const firstScore = document.querySelector<HTMLElement>('.score:not([hidden])');
  if (firstScore && 'IntersectionObserver' in window && !reducedMotion.matches) {
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          observer.disconnect();
          const visible = document.querySelector<HTMLElement>('.score:not([hidden])');
          if (visible && !visible.classList.contains('is-armed')) {playScore(visible);}
        }
      },
      { threshold: 0.35 },
    );
    observer.observe(firstScore);
  }
</script>
