---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { LinkButton } from '@astrojs/starlight/components';
import { agents, type Agent } from '../data/agents.js';

const orchestrator = agents.find((agent) => agent.id === 'orchestrator');
const specialists = agents.filter((agent) => agent.id !== 'orchestrator');
---

<StarlightPage
  frontmatter={{
    title: 'Maestria',
    description: 'Portable AI engineering praxis plugins for OpenCode and beyond. Installable, self-wiring plugins that encode effective workflows.',
    template: 'splash',
    hero: { tagline: '' },
    editUrl: false,
    lastUpdated: false,
  }}
>
  <div class="home">
    <section class="home-hero">
      <div class="hero-copy">
        <h1>Maestria</h1>
        <p class="tagline">Portable AI engineering praxis, encoded as plugins.</p>
        <div class="hero-cta">
          <LinkButton href="/cli/getting-started/" class="sl-link-button">Get Started</LinkButton>
          <LinkButton href="/core/agents/" class="sl-link-button" variant="secondary">Browse Agents</LinkButton>
        </div>
      </div>

      <aside
        class="hero-artifact"
        aria-label="Pipeline map: the orchestrator routes tasks to seven specialist agents"
      >
        <div class="artifact-head">
          <span class="artifact-label">Methodology Map</span>
          <span class="artifact-count">8 roles · 1 dispatcher</span>
        </div>
        <div class="artifact-map">
          {orchestrator && (
            <div class="artifact-node artifact-orchestrator">
              <span class="artifact-node-icon" aria-hidden="true">{orchestrator.icon}</span>
              <span class="artifact-node-name">{orchestrator.name}</span>
              <span class="artifact-node-role">{orchestrator.role}</span>
            </div>
          )}
          <div class="artifact-connector" aria-hidden="true">
            <span class="artifact-stem"></span>
            <span class="artifact-bar"></span>
          </div>
          <ul class="artifact-specialists">
            {specialists.map((agent: Agent) => (
              <li class="artifact-node">
                <span class="artifact-node-icon" aria-hidden="true">{agent.icon}</span>
                <span class="artifact-node-name">{agent.name}</span>
                <span class="artifact-node-role">{agent.role}</span>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </section>

    <section class="home-section features">
      <h2 class="section-title">
        <span class="section-index" aria-hidden="true">01</span>
        Why Maestria?
      </h2>
      <div class="features-grid">
        <article class="feature-card">
          <div class="feature-card-head">
            <span class="feature-card-icon" aria-hidden="true">🔌</span>
            <span class="feature-card-num" aria-hidden="true">01</span>
          </div>
          <h3>Pipeline Composition</h3>
          <p>Chain specialist agents into adaptive workflows. Each agent handles one cognitive role - thinker, worker, verifier - and the orchestrator sequences them dynamically based on task needs.</p>
        </article>
        <article class="feature-card">
          <div class="feature-card-head">
            <span class="feature-card-icon" aria-hidden="true">🛡️</span>
            <span class="feature-card-num" aria-hidden="true">02</span>
          </div>
          <h3>Maker/Checker Split</h3>
          <p>The agent that writes code never reviews it. Every implementation passes through a separate reviewer, catching issues that same-agent QA would miss.</p>
        </article>
        <article class="feature-card">
          <div class="feature-card-head">
            <span class="feature-card-icon" aria-hidden="true">🌐</span>
            <span class="feature-card-num" aria-hidden="true">03</span>
          </div>
          <h3>Platform Independence</h3>
          <p>Core logic lives in platform-agnostic packages. Plugin adapters for OpenCode, Kimi Code, and Pi keep the same agent behavior across different AI platforms.</p>
        </article>
      </div>
    </section>

    <section class="home-section agent-showcase">
      <h2 class="section-title">
        <span class="section-index" aria-hidden="true">02</span>
        The Pipeline
      </h2>
      <p>Eight specialist agents, each handling one cognitive role. The orchestrator sequences them dynamically.</p>

      <div class="agent-tabs" role="tablist">
        {agents.map((agent: Agent, index: number) => (
          <button
            class="agent-tab"
            role="tab"
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-controls={`panel-${agent.id}`}
            id={`tab-${agent.id}`}
          >
            <span class="agent-tab-icon">{agent.icon}</span>
            <span class="agent-tab-name">{agent.name}</span>
          </button>
        ))}
      </div>

      {agents.map((agent: Agent, index: number) => (
        <div
          class="agent-panel"
          role="tabpanel"
          id={`panel-${agent.id}`}
          aria-labelledby={`tab-${agent.id}`}
          hidden={index !== 0}
        >
          <h3>{agent.name}</h3>
          <p class="agent-role">{agent.role}</p>
          <p>{agent.description}</p>
        </div>
      ))}
    </section>

    <section class="home-section platforms">
      <h2 class="section-title">
        <span class="section-index" aria-hidden="true">03</span>
        Built for Your Stack
      </h2>
      <p>Maestria ships as plugins for the AI coding platforms you already use.</p>

      <div class="product-grid">
        <a href="/opencode/" class="product-card">
          <span class="product-card-icon">
            <svg
              width="28"
              height="28"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <polyline points="4 17 10 11 4 5" />
              <line x1="12" y1="19" x2="20" y2="19" />
            </svg>
          </span>
          <h2>@maestria/opencode</h2>
          <p>8 specialized agents with global rules injected into every session.</p>
          <span class="product-card-link">Learn more →</span>
        </a>

        <a href="/kimi-code/" class="product-card">
          <span class="product-card-icon">
            <svg
              width="28"
              height="28"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="5" r="2" />
              <circle cx="5" cy="19" r="2" />
              <circle cx="19" cy="19" r="2" />
              <line x1="12" y1="7" x2="5" y2="17" />
              <line x1="12" y1="7" x2="19" y2="17" />
              <line x1="7" y1="19" x2="17" y2="19" />
            </svg>
          </span>
          <h2>@maestria/kimi-code</h2>
          <p>8 specialized skills with swarm-aware orchestration and no build step.</p>
          <span class="product-card-link">Learn more →</span>
        </a>

        <a href="/cursor/" class="product-card">
          <span class="product-card-icon">
            <svg
              width="28"
              height="28"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="3" y="3" width="18" height="18" rx="2" />
              <path d="M9 9h6v6H9z" />
            </svg>
          </span>
          <h2>@maestria/cursor</h2>
          <p>Specialist agents, orchestrator skill, and workflow commands for Cursor IDE and CLI.</p>
          <span class="product-card-link">Learn more →</span>
        </a>

        <a href="/pi-omp/" class="product-card">
          <span class="product-card-icon">
            <svg
              width="28"
              height="28"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <polygon points="5 3 19 12 5 21 5 3" />
            </svg>
          </span>
          <h2>@maestria/pi</h2>
          <p>7 specialist subagents with spec-driven orchestration for Pi and Oh My Pi.</p>
          <span class="product-card-link">Learn more →</span>
        </a>
      </div>
    </section>
  </div>
</StarlightPage>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('.agent-tab');
    const panels = document.querySelectorAll('.agent-panel');

    function activateTab(tab: Element) {
      tabs.forEach(t => t.setAttribute('aria-selected', 'false'));
      panels.forEach(p => p.setAttribute('hidden', ''));

      tab.setAttribute('aria-selected', 'true');
      const panelId = tab.getAttribute('aria-controls');
      const panel = document.getElementById(panelId!);
      if (panel) panel.removeAttribute('hidden');

      // Track agent tab click
      if (typeof window !== 'undefined' && window.umami) {
        const agentName = tab.querySelector('.agent-tab-name')?.textContent?.trim() || tab.textContent?.trim();
        window.umami.track('agent_tab_click', { agent: agentName });
      }
    }

    tabs.forEach(tab => {
      tab.addEventListener('click', () => activateTab(tab));
    });

    document.addEventListener('keydown', (e) => {
      const target = e.target as HTMLElement;
      const tab = target.closest('.agent-tab');
      if (!tab) return;

      const tabsArray = Array.from(tabs);
      const index = tabsArray.indexOf(tab);

      let nextIndex: number | null = null;
      if (e.key === 'ArrowRight') nextIndex = (index + 1) % tabsArray.length;
      if (e.key === 'ArrowLeft') nextIndex = (index - 1 + tabsArray.length) % tabsArray.length;
      if (e.key === 'Home') nextIndex = 0;
      if (e.key === 'End') nextIndex = tabsArray.length - 1;

      if (nextIndex !== null) {
        e.preventDefault();
        activateTab(tabsArray[nextIndex]);
        (tabsArray[nextIndex] as HTMLElement).focus();
      }
    });
  });
</script>
