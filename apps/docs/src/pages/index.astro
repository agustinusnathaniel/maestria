---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import InstallCommand from '@/components/plugin/InstallCommand.astro';
import SiteFooter from '@/components/plugin/SiteFooter.astro';
import { agents, type Agent } from '@/data/agents.js';
import { platforms } from '@/data/platforms.js';
import { marks, markAttrs } from '@/data/marks.js';

/**
 * Static per-agent metadata for the specialist panel. Derived from the agent
 * descriptions in src/data/agents.ts (source of truth:
 * packages/core/agent-directives/specialists/*.md). agents.ts is not modified.
 */
const agentMeta: Record<string, { scope: string; artifact: string; constraint: string }> = {
  orchestrator: {
    scope: 'Dispatch only - never implements',
    artifact: 'Route assignments, commit protocol',
    constraint: 'Maker/checker split enforced',
  },
  adventurer: {
    scope: 'Unfamiliar code territory',
    artifact: 'Reconnaissance report',
    constraint: 'Read-only - no edits',
  },
  architect: {
    scope: 'Approach selection, trade-offs',
    artifact: 'Decision record (ADR)',
    constraint: 'Decisions documented, not coded',
  },
  builder: {
    scope: 'One atomic task',
    artifact: 'Implementation + tests',
    constraint: 'Never reviews its own work',
  },
  diagnose: {
    scope: 'Regressions, incidents',
    artifact: 'Root cause analysis',
    constraint: 'Root cause before fix',
  },
  planner: {
    scope: 'Complex, multi-step features',
    artifact: 'Phased implementation plan',
    constraint: 'Plan first, build later',
  },
  reviewer: {
    scope: 'Pre-merge quality gates',
    artifact: 'Review verdict',
    constraint: 'Sees work fresh - independent',
  },
  writer: {
    scope: 'Documentation and prose',
    artifact: 'Structured docs',
    constraint: 'Follows the source of truth',
  },
};

interface DocLink {
  href: string;
  title: string;
  desc: string;
  external?: boolean;
}

/**
 * Open docs navigation map. Every route is verified against
 * src/content/docs; omitted routes are never invented. The platform directory
 * lives in the Adapters section (03), so it is not duplicated here.
 */
const docsMap: { group: string; items: DocLink[] }[] = [
  {
    group: 'CLI',
    items: [
      {
        href: '/cli/getting-started/',
        title: 'Getting Started',
        desc: 'Run maestria via npx anywhere Node 22+ is available - no install step.',
      },
    ],
  },
  {
    group: 'Core',
    items: [
      {
        href: '/core/how-it-works/',
        title: 'How It Works',
        desc: 'The dispatcher, seven specialists, and the staged pipeline.',
      },
      {
        href: '/core/pipeline/',
        title: 'Pipeline & Roles',
        desc: 'Thinker, worker, and verifier roles and the maker/checker split.',
      },
      {
        href: '/core/agents/',
        title: 'Specialist Reference',
        desc: 'All eight agents: scope, artifact, and constraint for each.',
      },
      {
        href: '/core/when-to-use/',
        title: 'When to Use',
        desc: 'Decide between direct execution, a specialist, or the full pipeline.',
      },
    ],
  },
  {
    group: 'Community',
    items: [
      {
        href: 'https://github.com/agustinusnathaniel/maestria',
        title: 'GitHub repository',
        desc: 'Source, issues, and releases for every package.',
        external: true,
      },
      {
        href: '/core/contributing/',
        title: 'Contributing',
        desc: 'Add an adapter or improve the core methodology.',
      },
      {
        href: '/core/changelog/',
        title: 'Changelog',
        desc: 'What changed across the ecosystem.',
      },
    ],
  },
];

const INSTALL_CMD = 'npx maestria install opencode';
---

<StarlightPage
  frontmatter={{
    title: 'Maestria',
    description:
      'A portable harness for AI coding agents. Route complex work through specialists, structured handoffs, and independent review.',
    template: 'splash',
    hero: { tagline: '' },
    editUrl: false,
    lastUpdated: false,
  }}
>
  <div class="home">
    <div class="home-glow" aria-hidden="true"></div>
    <div class="home-grid" aria-hidden="true"></div>

    <div class="home-inner">
      <!-- ============================== 1. HERO ============================== -->
      <section
        class="flex flex-col items-center text-center pt-[clamp(4.5rem,9vw,6.5rem)] max-md:pt-12 min-w-0 home-hero-anim"
        aria-labelledby="home-title"
      >
        <p class="font-mono text-xs uppercase tracking-[0.14em] text-home-text-muted mb-5 max-md:mb-2">OPEN-SOURCE METHODOLOGY LAYER</p>
        <h1 id="home-title" class="text-[clamp(2.75rem,7vw,4.75rem)] max-md:text-[clamp(1.875rem,9vw,2.5rem)] font-[540] leading-[1.04] tracking-[-0.04em] text-balance text-home-text max-w-[20ch] mb-6 max-md:mb-3">
          Make the work <span class="text-home-accent">deliberate.</span>
        </h1>
        <p class="text-[clamp(1.05rem,1.6vw,1.25rem)] max-md:text-[0.875rem] leading-[1.6] max-md:leading-[1.55] text-home-text-soft max-w-[40ch] mb-9 max-md:mb-4 mx-auto text-pretty">
          A portable harness for AI coding agents. Route complex work through
          specialists, structured handoffs, and independent review.
        </p>
        <!-- Spacing to the install chip rides on margin-bottom: the unlayered
             markdown reset zeroes sibling margin-top inside .home. -->
        <div class="flex items-center justify-center flex-wrap gap-[1.4rem] max-md:gap-4 max-sm:gap-3.5 mb-6">
          <a class="inline-flex items-center justify-center max-sm:w-full min-h-[44px] py-2.5 px-6 bg-home-accent text-home-accent-ink border border-home-accent rounded-[3px] font-sans text-[0.9375rem] font-[560] tracking-[0.01em] no-underline transition-colors hover:bg-home-accent-strong hover:border-home-accent-strong active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--home-focus)]" href="/cli/getting-started/">Get Started</a>
          <a class="inline-flex items-center justify-center max-sm:w-full gap-[0.4rem] min-h-[44px] py-1 px-0.5 text-home-text-soft font-sans text-[0.9375rem] font-medium no-underline border-b border-home-border-strong transition-colors hover:text-home-text hover:border-home-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--home-focus)]" href="#pipeline">
            Explore the pipeline<span aria-hidden="true">↓</span>
          </a>
        </div>
        <InstallCommand command={INSTALL_CMD} location="home-hero" />
      </section>

      <!-- ========================= 2. HARNESS TRANSCRIPT ========================= -->
      <section class="term-wrap pt-[clamp(3.5rem,7vw,5rem)] mb-[var(--home-section-gap)] min-w-0" aria-labelledby="term-title">
        <h2 id="term-title" class="sr-only">Harness transcript example</h2>
        <div class="term mx-auto w-full max-w-[46rem]">
          <div class="term-bar">
            <span class="term-title">maestria<span class="term-title-suffix"> - harness transcript</span></span>
            <span class="term-badge">EXAMPLE</span>
          </div>
          <div class="term-body">
            <p class="term-line term-cmd" style="--i: 0"><span class="term-prompt" aria-hidden="true">$ </span>npx maestria install opencode</p>
            <p class="term-line term-out" style="--i: 1"><span class="term-ok" aria-hidden="true">✓ </span>@maestria/opencode installed - 8 specialists wired</p>
            <div class="term-spacer" aria-hidden="true"></div>
            <p class="term-line term-cmd" style="--i: 2"><span class="term-prompt" aria-hidden="true">$ </span>maestria status</p>
            <div class="term-row term-status-row" style="--i: 3">
              <span class="term-cell">opencode</span>
              <span class="term-state"><span class="term-ok" aria-hidden="true">✓ </span>connected</span>
              <span class="term-cell">claude-code</span>
              <span class="term-state"><span class="term-ok" aria-hidden="true">✓ </span>connected</span>
            </div>
            <div class="term-row term-status-row" style="--i: 4">
              <span class="term-cell">kimi-code</span>
              <span class="term-state"><span class="term-open" aria-hidden="true">○ </span>available</span>
              <span class="term-cell">cursor</span>
              <span class="term-state"><span class="term-open" aria-hidden="true">○ </span>available</span>
            </div>
            <div class="term-spacer" aria-hidden="true"></div>
            <p class="term-line term-comment" style="--i: 5"># one task through the harness - thinker, worker, verifier</p>
            <div class="term-row term-task-row" style="--i: 6">
              <span class="term-role">thinker</span><span class="term-agent">adventurer</span>
              <span class="term-artifact"><span aria-hidden="true">→ </span>recon report</span>
              <span class="term-done term-ok" aria-hidden="true">✓</span>
            </div>
            <div class="term-row term-task-row" style="--i: 7">
              <span class="term-role">thinker</span><span class="term-agent">architect</span>
              <span class="term-artifact"><span aria-hidden="true">→ </span>decision record</span>
              <span class="term-done term-ok" aria-hidden="true">✓</span>
            </div>
            <div class="term-row term-task-row" style="--i: 8">
              <span class="term-role">planner</span><span class="term-agent"></span>
              <span class="term-artifact"><span aria-hidden="true">→ </span>phased plan</span>
              <span class="term-done term-ok" aria-hidden="true">✓</span>
            </div>
            <div class="term-row term-task-row" style="--i: 9">
              <span class="term-role">worker</span><span class="term-agent">builder</span>
              <span class="term-artifact"><span aria-hidden="true">→ </span>implementation + tests</span>
              <span class="term-done term-ok" aria-hidden="true">✓</span>
            </div>
            <div class="term-row term-task-row" style="--i: 10">
              <span class="term-role">verifier</span><span class="term-agent">reviewer</span>
              <span class="term-artifact"><span aria-hidden="true">→ </span>verdict: approved</span>
              <span class="term-done term-ok" aria-hidden="true">✓<span class="term-cursor" aria-hidden="true">▍</span></span>
            </div>
          </div>
        </div>
      </section>

      <!-- ============================ 3. THE METHOD ============================ -->
      <section class="home-section mb-[var(--home-section-gap)]" aria-labelledby="method-title">
        <p class="section-eyebrow">01 / THE METHOD</p>
        <h2 id="method-title">Structure beats improvisation.</h2>
        <div class="grid grid-cols-3 max-lg:grid-cols-1 gap-x-[clamp(2rem,4vw,3rem)] max-lg:gap-y-10">
          <article class="group border-t border-home-border pt-[1.5rem] min-w-0">
            <div class="flex items-center justify-between gap-4">
              <span class="method-num">01</span>
              <svg class="w-[26px] h-[26px] text-home-text-muted" {...markAttrs} set:html={marks.pipeline} />
            </div>
            <h3 class="mt-5 mb-2 text-[19px] leading-[1.3] font-[590] tracking-[-0.01em] text-home-text">Pipeline composition</h3>
            <p class="text-[0.9375rem] leading-[1.65] text-home-text-soft m-0">
              Route work through focused stages instead of asking one context
              to do everything.
            </p>
          </article>
          <article class="group border-t border-home-border pt-[1.5rem] min-w-0">
            <div class="flex items-center justify-between gap-4">
              <span class="method-num">02</span>
              <svg class="w-[26px] h-[26px] text-home-text-muted" {...markAttrs} set:html={marks.makerChecker} />
            </div>
            <h3 class="mt-5 mb-2 text-[19px] leading-[1.3] font-[590] tracking-[-0.01em] text-home-text">Maker/checker split</h3>
            <p class="text-[0.9375rem] leading-[1.65] text-home-text-soft m-0">The builder produces; the reviewer sees it fresh.</p>
          </article>
          <article class="group border-t border-home-border pt-[1.5rem] min-w-0">
            <div class="flex items-center justify-between gap-4">
              <span class="method-num">03</span>
              <svg class="w-[26px] h-[26px] text-home-text-muted" {...markAttrs} set:html={marks.platforms} />
            </div>
            <h3 class="mt-5 mb-2 text-[19px] leading-[1.3] font-[590] tracking-[-0.01em] text-home-text">Platform independence</h3>
            <p class="text-[0.9375rem] leading-[1.65] text-home-text-soft m-0">
              Methodology stays consistent while each platform uses native
              primitives.
            </p>
          </article>
        </div>
      </section>

      <!-- =========================== 4. SPECIALISTS =========================== -->
      <section class="home-section mb-[var(--home-section-gap)] scroll-mt-[calc(var(--sl-nav-height)+2rem)]" id="pipeline" aria-labelledby="agents-title">
        <p class="section-eyebrow">02 / SPECIALISTS</p>
        <h2 id="agents-title">The conductor is not the crew.</h2>
        <div class="grid grid-cols-[minmax(0,20rem)_minmax(0,1fr)] gap-[clamp(1.5rem,3vw,2.5rem)] items-start max-lg:grid-cols-1">
          <div class="flex flex-col" role="tablist" aria-label="Specialists">
            {agents.map((agent: Agent, index: number) => (
              <button
                class="agent-tab relative flex items-center gap-3 min-h-[44px] py-2 pr-2.5 bg-transparent border-0 border-t border-home-border rounded-none text-home-text-muted font-sans text-[0.9375rem] font-medium text-left cursor-pointer transition-colors hover:text-home-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--home-focus)]"
                role="tab"
                aria-selected={index === 0 ? 'true' : 'false'}
                aria-controls={`panel-${agent.id}`}
                id={`tab-${agent.id}`}
                tabindex={index === 0 ? 0 : -1}
              >
                <svg class="w-5 h-5 flex-none" {...markAttrs} set:html={marks[agent.id]} />
                <span class="agent-tab-name whitespace-nowrap">{agent.name}</span>
                <span class="agent-tab-role">{agent.role}</span>
              </button>
            ))}
          </div>
          <div class="border border-home-border rounded-[3px] bg-home-surface min-h-[24rem]">
            {agents.map((agent: Agent, index: number) => (
              <div
                class="agent-panel p-[clamp(1.5rem,3vw,2rem)]"
                role="tabpanel"
                id={`panel-${agent.id}`}
                aria-labelledby={`tab-${agent.id}`}
                hidden={index !== 0}
              >
                <div class="flex items-start gap-4">
                  <svg class="w-7 h-7 flex-none text-home-text-muted mt-[0.2rem]" {...markAttrs} set:html={marks[agent.id]} />
                  <div>
                    <h3 class="text-[clamp(1.375rem,2.5vw,1.75rem)] font-[560] leading-[1.15] tracking-[-0.02em] text-home-text m-0">{agent.name}</h3>
                    <p class="mt-1 text-sm font-[550] text-home-accent">{agent.role}</p>
                  </div>
                </div>
                <p class="mt-5 max-w-46rem text-[0.9375rem] leading-[1.7] text-home-text-soft">{agent.description}</p>
                <dl class="mt-7 mb-0 p-0 border-t border-home-border">
                  <div class="grid grid-cols-[6.5rem_minmax(0,1fr)] gap-4 py-[0.8125rem] border-b border-home-border">
                    <dt class="text-[0.75rem] font-semibold tracking-[0.06em] uppercase text-home-text-muted m-0 pl-0">Scope</dt>
                    <dd class="text-sm text-home-text-soft m-0 pl-0">{agentMeta[agent.id].scope}</dd>
                  </div>
                  <div class="grid grid-cols-[6.5rem_minmax(0,1fr)] gap-4 py-[0.8125rem] border-b border-home-border">
                    <dt class="text-[0.75rem] font-semibold tracking-[0.06em] uppercase text-home-text-muted m-0 pl-0">Artifact</dt>
                    <dd class="text-sm text-home-text-soft m-0 pl-0">{agentMeta[agent.id].artifact}</dd>
                  </div>
                  <div class="grid grid-cols-[6.5rem_minmax(0,1fr)] gap-4 py-[0.8125rem] border-b border-home-border">
                    <dt class="text-[0.75rem] font-semibold tracking-[0.06em] uppercase text-home-text-muted m-0 pl-0">Constraint</dt>
                    <dd class="text-sm text-home-text-soft m-0 pl-0">{agentMeta[agent.id].constraint}</dd>
                  </div>
                </dl>
                <a
                  class="panel-more inline-flex items-center gap-1.5 mt-7 border-t border-home-border pt-[1rem] text-[13px] font-medium text-home-text-soft no-underline transition-colors hover:text-home-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--home-focus)]"
                  href="/core/agents/"
                >
                  Full specialist reference<span class="panel-more-arrow" aria-hidden="true">→</span>
                </a>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- ============================ 5. ADAPTERS ============================ -->
      <section class="home-section mb-[clamp(4rem,9vw,6rem)]" id="adapters" aria-labelledby="platforms-title">
        <p class="section-eyebrow">03 / ADAPTERS</p>
        <h2 id="platforms-title">One methodology. Native primitives.</h2>
        <div class="grid grid-cols-3 border-t border-l border-home-border max-lg:grid-cols-1">
          {platforms.map((platform) => (
            <a
              class:list={[
                'group relative flex flex-col items-start gap-[0.4rem] p-[clamp(1.25rem,2.5vw,1.75rem)] border-r border-b border-home-border bg-transparent no-underline text-inherit min-w-0 transition-colors hover:border-home-border-strong hover:bg-home-surface focus-visible:border-home-border-strong focus-visible:bg-home-surface focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--home-focus)]',
                { 'platform-flagship': platform.flagship === true },
                { 'platform-aux': platform.auxiliary === true },
              ]}
              href={platform.href}
            >
              <svg class="w-6 h-6 text-home-text-muted mb-2" {...markAttrs} set:html={marks[platform.mark]} />
              <span class="flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-[0.9375rem] text-home-text transition-colors group-hover:text-home-accent group-focus-visible:text-home-accent">
                {platform.name}
                {platform.badge && <span class="platform-badge">{platform.badge}</span>}
              </span>
              <span class="text-[0.84375rem] leading-[1.55] text-home-text-muted">{platform.blurb}</span>
            </a>
          ))}
        </div>
      </section>
    </div>

    <!-- ============================= 6. PUNCH BAND ============================= -->
    <section class="w-full bg-home-punch text-home-punch-ink mb-[var(--home-section-gap)]" aria-label="Maestria by the numbers">
      <div class="max-w-7xl mx-auto py-[clamp(2.75rem,6vw,4.25rem)] px-[clamp(1.25rem,4vw,2.5rem)] grid grid-cols-4 gap-6 max-md:grid-cols-2 max-md:gap-8">
        <div>
          <span class="block text-[clamp(2.5rem,6vw,4rem)] font-[560] leading-none tracking-[-0.03em] tabular-nums text-home-punch-ink">8</span>
          <span class="block mt-2.5 text-xs font-semibold tracking-[0.08em] uppercase text-home-punch-ink/70">SPECIALISTS</span>
        </div>
        <div>
          <span class="block text-[clamp(2.5rem,6vw,4rem)] font-[560] leading-none tracking-[-0.03em] tabular-nums text-home-punch-ink">3</span>
          <span class="block mt-2.5 text-xs font-semibold tracking-[0.08em] uppercase text-home-punch-ink/70">COGNITIVE ROLES</span>
        </div>
        <div>
          <span class="block text-[clamp(2.5rem,6vw,4rem)] font-[560] leading-none tracking-[-0.03em] tabular-nums text-home-punch-ink">9</span>
          <span class="block mt-2.5 text-xs font-semibold tracking-[0.08em] uppercase text-home-punch-ink/70">PLATFORM ADAPTERS</span>
        </div>
        <div>
          <span class="block text-[clamp(2.5rem,6vw,4rem)] font-[560] leading-none tracking-[-0.03em] tabular-nums text-home-punch-ink">0</span>
          <span class="block mt-2.5 text-xs font-semibold tracking-[0.08em] uppercase text-home-punch-ink/70">VENDOR LOCK-IN</span>
        </div>
      </div>
    </section>

    <div class="home-inner">
      <!-- ============================= 7. DOCS MAP ============================= -->
      <section class="home-section" aria-labelledby="docs-title">
        <p class="section-eyebrow">04 / FIND YOUR WAY</p>
        <h2 id="docs-title">Start with the system.</h2>
        <div>
          {docsMap.map((group, gi) => (
            <div>
              <p class:list={[
                'pt-2 pb-2 font-mono text-xs font-medium tracking-[0.1em] uppercase text-home-text-muted',
                gi === 0 ? 'mt-0' : 'mt-9'
              ]}>{group.group}</p>
              {group.items.map((item, ii) => (
                <a
                  class:list={[
                    'group grid grid-cols-[minmax(0,15rem)_minmax(0,1fr)_auto] items-baseline gap-4 py-3.5 px-0.5 border-t border-home-border no-underline min-w-0 max-md:grid-cols-[minmax(0,1fr)_auto] focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-[var(--home-focus)]',
                    ii === group.items.length - 1 && 'border-b'
                  ]}
                  href={item.href}
                  target={item.external ? '_blank' : undefined}
                  rel={item.external ? 'noopener noreferrer' : undefined}
                >
                  <span class="text-[0.9375rem] font-[560] text-home-text transition-colors group-hover:text-home-accent">{item.title}</span>
                  <span class="text-sm leading-[1.5] text-home-text-muted max-md:col-span-full">{item.desc}</span>
                  <span class="text-home-text-muted transition-colors group-hover:text-home-accent group-hover:translate-x-[3px] max-md:col-2 max-md:row-1 max-md:justify-self-end" aria-hidden="true">→</span>
                </a>
              ))}
            </div>
          ))}
        </div>
      </section>

      <!-- =============================== 8. FOOTER =============================== -->
      <SiteFooter />
    </div>
  </div>
</StarlightPage>

<style>
  /* Hero animation - moved from global.css */
  @keyframes home-reveal {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .home-hero-anim,
    .term-wrap {
      animation: home-reveal 340ms ease-out both;
    }

    .home-hero-anim {
      animation-delay: 40ms;
    }

    .term-wrap {
      animation-delay: 140ms;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero-anim,
    .term-wrap {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .home-hero-anim,
    .term-wrap {
      opacity: 1;
      transform: none;
    }
  }

  /* ============================================
     SECTION EYEBROWS - monospace identity moment
     ============================================ */

  .section-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.14em;
  }

  /* ============================================
     HARNESS TRANSCRIPT
     Fixed dark artifact in BOTH themes - literal
     values, not theme vars.
     ============================================ */

  .term {
    background: #0d110c;
    border: 1px solid rgba(240, 245, 239, 0.14);
    border-radius: 8px;
    box-shadow: 0 24px 64px -28px rgba(0, 0, 0, 0.55);
    color: #e7ece3;
    overflow: hidden;
  }

  .term-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.55rem 1.25rem;
    background: rgba(240, 245, 239, 0.04);
    border-bottom: 1px solid rgba(240, 245, 239, 0.1);
  }

  .term-title {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: #9fab97;
    /* The title bar stays one line at every width; see the suffix rule
       below for the narrow-viewport half of this contract. */
    white-space: nowrap;
  }

  /* Below 480px the descriptive suffix hides, leaving "maestria" beside the
     EXAMPLE pill - the bar can never wrap into a cramped second line. */
  @media (max-width: 480px) {
    .term-title-suffix {
      display: none;
    }
  }

  .term-badge {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    color: #9fab97;
    border: 1px solid rgba(240, 245, 239, 0.22);
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
  }

  .term-body {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.75;
    padding: 1.25rem 1.5rem;
    overflow-x: auto;
  }

  .term-line,
  .term-row {
    margin: 0;
    color: #e7ece3;
  }

  .term-prompt,
  .term-ok {
    color: #b7ef5f;
  }

  /* ○ status glyphs only; label text keeps #9fab97. */
  .term-open {
    color: #aab5a2;
  }

  .term-comment {
    color: #97a28b;
  }

  .term-spacer {
    height: 1.75em;
  }

  /* Status rows: fixed-width name columns keep the rhythm without
     hand-spaced strings. The fluid columns use `minmax(0, …)` so grid items
     can shrink below their min-content width when space runs out instead of
     overflowing the card; text wraps rather than spills. */
  .term-status-row {
    display: grid;
    grid-template-columns: 7.25rem minmax(3rem, 1fr) 7.25rem minmax(0, 1fr);
    column-gap: 1rem;
    padding-left: 1.5rem;
  }

  .term-status-row .term-state {
    color: #9fab97;
  }

  /* Task rows: role / agent fixed columns, artifact fluid, verdict right. */
  .term-task-row {
    display: grid;
    grid-template-columns: 4.75rem 6.75rem minmax(0, 1fr) auto;
    column-gap: 1rem;
    padding-left: 1.5rem;
  }

  .term-task-row .term-role {
    color: #9fab97;
  }

  .term-done {
    text-align: right;
  }

  /* Blinking block cursor after the last line. Kept clear of the verdict
     glyph so the caret reads as terminal continuation, never as collision. */
  .term-cursor {
    display: inline-block;
    margin-inline-start: 0.75ch;
    color: #b7ef5f;
  }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes term-in {
      from {
        opacity: 0;
        transform: translateY(6px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }

    @keyframes term-blink {
      50% {
        opacity: 0;
      }
    }

    /* Progressive enhancement: lines are fully visible by default; JS adds
       .term-play when the card enters the viewport, then lines stagger in. */
    .term.term-play .term-line,
    .term.term-play .term-row {
      opacity: 0;
      animation: term-in 220ms ease-out forwards;
      animation-delay: calc(var(--i, 0) * 60ms);
    }

    .term-cursor {
      animation: term-blink 1.1s step-end infinite;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .term.term-play .term-line,
    .term.term-play .term-row {
      opacity: 1;
      animation: none;
    }

    .term-cursor {
      animation: none;
    }
  }

  /* Narrow viewports: let transcript rows reflow into intentional blocks
     instead of soft-wrapping mid-cell. Status pairs collapse to one
     platform-pair per line; task rows become explicit two-line entries -
     stage tag + agent on line 1 with the verdict right-aligned, artifact
     indented below so continuations never return flush-left (solo agents
     keep the same slots via an empty partner span). The install output gets
     a hanging indent for the same reason. Fluid tracks plus overflow-wrap
     keep every cell inside the card. Desktop is untouched. */
  @media (max-width: 480px) {
    .term-status-row {
      /* Four cells auto-place into two rows: one platform-pair each. */
      grid-template-columns: minmax(0, 7.25rem) minmax(0, 1fr);
      row-gap: 0.1em;
    }

    .term-task-row {
      /* Line 1: role + agent left, `1fr` filler pushes the verdict right.
         Line 2: artifact spans all tracks, indented past the stage column. */
      grid-template-columns: auto auto minmax(0, 1fr) auto;
      grid-template-areas:
        'role agent . done'
        'artifact artifact artifact artifact';
      row-gap: 0.1em;
    }

    .term-task-row .term-role {
      grid-area: role;
    }

    .term-task-row .term-agent {
      grid-area: agent;
    }

    .term-task-row .term-artifact {
      grid-area: artifact;
      padding-inline-start: 2ch;
    }

    .term-task-row .term-done {
      grid-area: done;
    }

    /* Hanging indent: wrapped install-output lines align under the message
       text, not under the leading ✓. */
    .term-out {
      padding-left: 2ch;
      text-indent: -2ch;
    }

    .term-line,
    .term-row span {
      overflow-wrap: anywhere;
    }
  }

  /* ============================================
     METHOD MODULES - numbered, hairline top
     ============================================ */

  .method-num {
    font-family: var(--font-mono);
    font-size: 1.125rem;
    line-height: 1;
    color: var(--home-accent);
    opacity: 0.7;
    transition: opacity 160ms ease;
  }

  .group:hover .method-num,
  .group:focus-within .method-num {
    opacity: 1;
  }

  /* ============================================
     AGENT TABS - active state upgrades
     ============================================ */

  .agent-tab[aria-selected='true'] {
    color: var(--home-text);
    font-weight: 560;
    background: var(--home-surface-raised);
  }

  .agent-tab[aria-selected='true']::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--home-accent);
  }

  .agent-tab[aria-selected='true'] .agent-mark,
  .agent-tab[aria-selected='true'] svg {
    color: var(--home-accent);
  }

  .agent-tab:last-child {
    border-bottom: 1px solid var(--home-border);
  }

  /* Role snippet: right-aligned, muted, desktop only; wraps to at most two
     lines instead of truncating mid-word. */
  .agent-tab-role {
    display: none;
    margin-left: auto;
    padding-left: 1rem;
    font-size: 0.75rem;
    font-weight: 400;
    line-height: 1.4;
    text-align: right;
    color: var(--home-text-muted);
    min-width: 0;
  }

  @media (min-width: 768px) {
    .agent-tab-role {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      line-clamp: 2;
      overflow: hidden;
    }
  }

  .agent-panel[hidden] {
    display: none;
  }

  /* Panel footer link: the dl keeps internal separators; drop the last row's
     border so the link's own top hairline is the single divider. */
  .agent-panel dl > div:last-child {
    border-bottom: 0;
  }

  .panel-more-arrow {
    transition: transform 160ms ease;
  }

  .panel-more:hover .panel-more-arrow,
  .panel-more:focus-visible .panel-more-arrow {
    transform: translateX(3px);
  }

  /* ============================================
     PLATFORM CARDS - flagship accent + aux ring
     ============================================ */

  .platform-flagship::before {
    content: '';
    position: absolute;
    top: -1px;
    left: -1px;
    width: 2rem;
    height: 2px;
    background: var(--home-accent);
  }

  .platform-aux::after {
    content: '';
    position: absolute;
    inset: 0.5rem;
    border: 1px dashed var(--home-border);
    border-radius: 3px;
    pointer-events: none;
  }

  .platform-badge {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    color: var(--home-text-muted);
    border: 1px solid var(--home-border-strong);
    border-radius: 3px;
    padding: 0.1rem 0.4rem;
    line-height: 1.4;
  }

  /* Starlight markdown content margin overrides. */
  .sl-markdown-content .flex.flex-col {
    margin-top: 0;
  }

  .sl-markdown-content .flex.flex-col > .agent-tab + .agent-tab {
    margin-top: 0;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('.agent-tab');
    const panels = document.querySelectorAll('.agent-panel');

    function activateTab(tab: Element) {
      tabs.forEach(t => {
        t.setAttribute('aria-selected', 'false');
        t.setAttribute('tabindex', '-1');
      });
      panels.forEach(p => p.setAttribute('hidden', ''));

      tab.setAttribute('aria-selected', 'true');
      tab.setAttribute('tabindex', '0');
      const panelId = tab.getAttribute('aria-controls');
      const panel = document.getElementById(panelId!);
      if (panel) panel.removeAttribute('hidden');

      // Track agent tab click
      if (typeof window !== 'undefined' && window.umami) {
        const agentName = tab.querySelector('.agent-tab-name')?.textContent?.trim() || tab.textContent?.trim();
        window.umami.track('agent_tab_click', { agent: agentName });
      }
    }

    tabs.forEach(tab => {
      tab.addEventListener('click', () => activateTab(tab));
    });

    document.addEventListener('keydown', (e) => {
      const target = e.target as HTMLElement;
      const tab = target.closest('.agent-tab');
      if (!tab) return;

      const tabsArray = Array.from(tabs);
      const index = tabsArray.indexOf(tab);

      // Roving tabindex. The tablist is laid out vertically, so Up/Down are
      // the primary APG keys; Left/Right stay as aliases. preventDefault()
      // below keeps Up/Down from scrolling the page.
      let nextIndex: number | null = null;
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') nextIndex = (index + 1) % tabsArray.length;
      if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') nextIndex = (index - 1 + tabsArray.length) % tabsArray.length;
      if (e.key === 'Home') nextIndex = 0;
      if (e.key === 'End') nextIndex = tabsArray.length - 1;

      if (nextIndex !== null) {
        e.preventDefault();
        activateTab(tabsArray[nextIndex]);
        (tabsArray[nextIndex] as HTMLElement).focus();
      }
    });

    // Harness transcript: stagger lines in once when >=30% of the card is
    // visible. Gated behind prefers-reduced-motion; CSS keeps lines fully
    // visible by default so this is pure progressive enhancement.
    const term = document.querySelector('.term');

    if (
      term &&
      typeof IntersectionObserver !== 'undefined' &&
      !window.matchMedia('(prefers-reduced-motion: reduce)').matches
    ) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('term-play');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.3 },
      );

      observer.observe(term);
    }
  });
</script>
