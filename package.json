{
  "name": "maestria",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run @maestria/docs#dev",
    "prepare": "vp config",
    "preview": "vp run @maestria/docs#preview",
    "sync:docs": "vp run --filter @maestria/docs sync",
    "prebuild": "vp run check-sync",
    "build": "vp run -r build",
    "build:ci": "vp run --filter './packages/*' --filter ./apps/maestria-cli build",
    "test": "vp run -r test",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm exec tsx scripts/sync-plugin-versions.ts",
    "release": "changeset publish",
    "check": "vp run build & P1=$!; vp run check-fmt & P2=$!; wait $P1 || FAIL=1; wait $P2 || FAIL=1; if [ -n \"$FAIL\" ]; then exit 1; fi && vp run check-lint && vp run test && vp run test-sync-plugin-versions && vp run check-manifest-versions",
    "check:ci": "vp run check-ci",
    "clean": "vp cache clean",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "typecheck": "vp check --no-fmt --no-lint",
    "contributors:add": "all-contributors add",
    "contributors:generate": "all-contributors generate",
    "contributors:check": "all-contributors check"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@types/node": "catalog:",
    "all-contributors-cli": "catalog:",
    "jsonc-parser": "catalog:",
    "tsx": "4.23.13",
    "ultracite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "yaml": "^2.9.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.16.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24.16.x"
  },
  "packageManager": "pnpm@12.4.1"
}
