{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/project-context.mjs\" codex",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|exec_command|shell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/git-safety.mjs\" codex",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/email-scan.mjs\" codex",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/env-dump.mjs\" codex",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/generated-guard.mjs\" codex",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/reviewer-guard.mjs\" codex",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
