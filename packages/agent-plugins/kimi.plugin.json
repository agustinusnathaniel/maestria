{
  "name": "maestria",
  "version": "0.15.0",
  "description": "Native Kimi specialist profiles, workflow commands, and complete session instructions",
  "keywords": [
    "maestria",
    "kimi-code",
    "skills",
    "orchestration",
    "engineering",
    "workflow",
    "swarm"
  ],
  "author": {
    "name": "Agustinus Nathaniel"
  },
  "homepage": "https://github.com/agustinusnathaniel/maestria",
  "license": "MIT",
  "skills": "./skills/",
  "commands": "./commands/",
  "systemPromptPath": "./kimi.system-prompt.md",
  "interface": {
    "displayName": "maestria Agent Pack",
    "shortDescription": "Native specialists and workflow commands for Kimi Code",
    "longDescription": "A native reviewer profile, complete primary-session policy and routing, three workflow commands, and eight maestria skills. Models, tool authority, and session lifecycle remain Kimi-owned.",
    "developerName": "Agustinus Nathaniel",
    "websiteURL": "https://github.com/agustinusnathaniel/maestria"
  },
  "agents": "./agents/",
  "hooks": [
    {
      "event": "PreToolUse",
      "matcher": "Bash",
      "command": "node ./hooks/git-safety.mjs kimi",
      "timeout": 10
    },
    {
      "event": "PreToolUse",
      "matcher": "Bash",
      "command": "node ./hooks/email-scan.mjs kimi",
      "timeout": 10
    },
    {
      "event": "PreToolUse",
      "matcher": "Bash",
      "command": "node ./hooks/env-dump.mjs kimi",
      "timeout": 10
    },
    {
      "event": "PreToolUse",
      "matcher": "Write|Edit",
      "command": "node ./hooks/generated-guard.mjs kimi",
      "timeout": 10
    }
  ]
}
