{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*", "./scripts/*"]
    },
    "noEmit": true,
    "lib": ["es2023"]
  },
  "include": ["scripts/**/*.ts", "tests/**/*.ts", "vite.config.ts"],
  "exclude": ["dist", "node_modules"]
}
